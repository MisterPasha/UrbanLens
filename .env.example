# Local development and disposable CI database.
# Setup generates LOCAL_POSTGRES_PASSWORD; keep real credentials in the ignored .env.
URBANLENS_ENVIRONMENT=local
LOCAL_POSTGRES_HOST=127.0.0.1
LOCAL_POSTGRES_PORT=54322
LOCAL_POSTGRES_DB=urbanlens
LOCAL_POSTGRES_USER=urbanlens_local
LOCAL_POSTGRES_PASSWORD=

# Optional live services: not needed for GitHub foundation checks.
COMPANIES_HOUSE_API_KEY=
URBANLENS_PIPELINE_DATABASE_URL=
URBANLENS_DBT_DATABASE_URL=
URBANLENS_API_DATABASE_URL=
