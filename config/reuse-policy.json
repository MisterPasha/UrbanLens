  "families": {
    "venues": "FSA published business facts under OGL; OSM derivative database under ODbL; approved owner factual corrections. Same withholding as the API; no contacts, contributor identities, raw tags or private notes.",
    "areas": "ONS population, boundaries and official land measures under source OGL terms and pinned OS/ONS/SAM notices.",
    "companies": "Factual public-register company fields and approved operating relationships; original source rights retained, no blanket OGL grant over submitted material. No filings, officers, PSCs, logos or creative documents.",
    "postcodes": "GB-derived geography only under source OGL/OS terms with OS, Royal Mail, National Statistics and NRS notices; reject BT postcodes.",
    "history": "Published observed differences and hash/rule metadata, never private retained evidence or historical location/address values.",
    "metadata": "Project-generated release/rule/hash metadata and aggregate measurements; no credentials, local paths, S3 locations or draft reviews."
  },
  "sources": {
    "fsa": "https://ratings.food.gov.uk/terms-and-conditions",
