{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["lhr1"],
  "functions": {
    "api/*.mjs": { "maxDuration": 15 }
  },
  "rewrites": [
    { "source": "/api/v1/:endpoint*", "destination": "/api/proxy?__urbanlens_path=:endpoint*" },
    { "source": "/health", "destination": "/api/proxy?__urbanlens_health=1" }
  ],
  "git": { "deploymentEnabled": false }
}
